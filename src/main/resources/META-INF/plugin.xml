<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>fr.antenia.antenia-projects</id>

    <!-- Public plugin name should be written in Title Case.
     Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Antenia Projects</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor>Antenia</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        Configures, runs, and manages local configuration for Antenia Neo projects.
        ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.java</depends>
    <depends>org.jetbrains.idea.maven</depends>
    <depends>com.intellij.javaee</depends>
    <depends>Tomcat</depends>
    <depends>JavaScript</depends>
    <depends>org.intellij.plugins.markdown</depends>
    <depends>com.intellij.modules.xml</depends>
    <depends>com.intellij.database</depends>
    <depends>com.intellij.properties</depends>
    <depends>com.intellij.modules.json</depends>
    <depends>org.jetbrains.plugins.yaml</depends>
    <depends>com.intellij.modules.vcs</depends>

    <resource-bundle>messages.MyMessageBundle</resource-bundle>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Neo Configuration" factoryClass="fr.antenia.ui.ConfigurationToolWindowFactory" anchor="right"
                    icon="AllIcons.Toolwindows.ToolWindowPalette"/>
        <applicationConfigurable parentId="tools" instance="fr.antenia.settings.AnteniaConfigurable"
                                  id="fr.antenia" bundle="messages.MyMessageBundle"
                                  key="configurable.antenia.display.name">
            <configurable instance="fr.antenia.credentials.GlobalDatabaseConfigurable"
                          id="fr.antenia.globalDatabase" bundle="messages.MyMessageBundle"
                          key="configurable.credentials.display.name"/>
            <configurable instance="fr.antenia.commit.CommitTemplatesConfigurable"
                          id="fr.antenia.commitTemplates" bundle="messages.MyMessageBundle"
                          key="configurable.commit.templates.display.name"/>
            <configurable instance="fr.antenia.settings.TomcatRunConfigurationConfigurable"
                          id="fr.antenia.runConfigurations" bundle="messages.MyMessageBundle"
                          key="configurable.run.configurations.display.name"/>
        </applicationConfigurable>
        <notificationGroup id="Antenia Projects" displayType="BALLOON" isLogByDefault="true"/>
        <postStartupActivity implementation="fr.antenia.automation.NeoProjectActivity"/>
        <runConfigurationExtension implementation="fr.antenia.run.NeoEnvironmentExtension"/>
    </extensions>

    <actions>
        <group id="fr.antenia.commit.TemplateGroup" class="fr.antenia.commit.CommitTemplateActionGroup"
                popup="true">
            <add-to-group group-id="Vcs.MessageActionGroup" anchor="after"
                          relative-to-action="Vcs.ShowMessageHistory"/>
        </group>
        <action id="fr.antenia.commit.MessageStatus" class="fr.antenia.commit.CommitMessageStatusAction"
                >
            <add-to-group group-id="Vcs.MessageActionGroup" anchor="after"
                          relative-to-action="fr.antenia.commit.TemplateGroup"/>
        </action>
    </actions>

    <applicationListeners>
        <listener class="fr.antenia.automation.JdkApplicationListener"
                  topic="com.intellij.ide.AppLifecycleListener"/>
        <listener class="fr.antenia.automation.TomcatApplicationListener"
                  topic="com.intellij.ide.AppLifecycleListener"/>
    </applicationListeners>

</idea-plugin>
